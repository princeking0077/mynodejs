<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force index.php to handle the root request instead of index.html
DirectoryIndex index.php index.html

# API requests fall through to /api directory
RewriteRule ^api/ - [L]

# Allow access to assets
RewriteRule ^assets/ - [L]

# Rewrite everything else to index.php for React Router handling
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
</IfModule>
