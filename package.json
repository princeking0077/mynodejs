        "express": "^4.18.2",
        "helmet": "^8.1.0",
        "http-proxy-middleware": "^3.0.5",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.6.5"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}