{
    "name": "pharma-app-root",
    "version": "1.1.0",
    "main": "index.js",
    "description": "Root Orchestration for Pharma App",
    "scripts": {
        "dev": "cd learnpharmacy-next && npm run dev",
        "build": "cd learnpharmacy-next && npm install --legacy-peer-deps && npm run build",
